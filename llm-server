case "${1:-}" in
    config)
        shift
        _settings_cmd "$@"
        exit $?
        ;;
    --version)
        echo "llm-server v$VERSION"
        exit 0
        ;;
    --help|-h)
        sed -n '3,/^$/s/^# \?//p' "$0"
        exit 0
        ;;
    --download)
        shift
        _download_model "$@"
        exit $?
        ;;
    --update)
        shift
        _do_update
        exit $?
        ;;
    *)
        _main_launch "$@"
        ;;
esac
