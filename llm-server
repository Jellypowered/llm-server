#!/bin/bash
# shellcheck disable=SC1090,SC2001,SC2034,SC2004,SC2155,SC2086,SC2015
#
# llm-server — Universal smart launcher for ik_llama.cpp / llama.cpp
# Auto-detects GPUs, RAM, model architecture (dense/MoE), and optimizes placement.
# Works on any system: 0-8+ GPUs, any VRAM/RAM configuration.
#
# Modular structure:
#   lib/00-constants.sh  – version, tuning constants
#   lib/01-helpers.sh    – utility functions
#   lib/02-config.sh     – config discovery, migration, settings subcommand
#   lib/03-args.sh       – argument parsing, tune key normalization
#   lib/04-hardware.sh   – GPU/CPU/RAM detection
#   lib/05-model.sh      – GGUF parsing, strategy selection, vision support
#   lib/06-flags.sh      – BASE_FLAGS, COMMON_FLAGS, flag building
#   lib/07-process.sh    – process management, health checks, restart loops
#   lib/08-benchmark.sh  – benchmarking
#   lib/09-ai-tune.sh    – AI-driven flag optimization
#   lib/10-moe.sh        – MoE expert placement & auto-tuning
#   lib/11-update.sh     – self-update and backend update
#   lib/12-show-configs.sh – config display
#
# Usage:
#   llm-server <repo/name> --download    # Download from HuggingFace
#   llm-server -h                        # Show this help message
#   llm-server <model.gguf>              # Launch (uses cached tune if available)
#   llm-server <model.gguf> --dry-run    # Print command without executing
#   llm-server --port 8082 <model.gguf>  # Custom port
#   llm-server <model.gguf> --benchmark  # Start, run quick benchmark, print tok/s
#   llm-server <model.gguf> --cpu        # Force CPU-only (ignore GPUs)
#   llm-server <model.gguf> --server-bin /path/to/llama-server
#   llm-server <model.gguf> --lib-path /path/to/libs
#   llm-server <model.gguf> --backend llama   # force llama.cpp
#   llm-server <model.gguf> --backend ik_llama # force ik_llama.cpp
#   llm-server <model.gguf> --kv-quality high  # KV cache: high(f16), mid(q8_0), low(q4_0)
#   llm-server <model.gguf> --kv-placement cpu # KV placement: auto, gpu, cpu
#   llm-server <model.gguf> --gpus 0,1         # Use only GPU 0 and 1
#   llm-server <model.gguf> --ram-budget 60G   # Cap RAM usage at 60GB
#   llm-server --update                         # Update llm-server + ik_llama.cpp + llama.cpp
#   llm-server <model.gguf> --vision           # Auto-detect/download mmproj for vision
#   llm-server <model.gguf> --mmproj auto      # Same as --vision
#   llm-server <model.gguf> --mmproj proj.gguf # Enable vision with specific mmproj file
#   llm-server <model.gguf> --ai-tune          # AI-driven flag optimization
#                                              # Scope auto-decided: MoE/single-GPU
#                                              # tunes perf flags only; dense multi-GPU
#                                              # also unlocks --tensor-split / --split-mode.
#                                              # User-explicit flags are always respected.
#   llm-server <model.gguf> --ai-tune --retune # Force re-tune even if cache exists
#   llm-server <model.gguf> --ai-tune --rounds 4 # Customize number of rounds
#   llm-server <model.gguf> --tune-cache cache.json # Launch with an explicit tuned config
#   llm-server <model.gguf> --ai-tune -v       # Verbose: show full ai-tune logs
#
# Environment variables:
#   LLAMA_SERVER    Path to llama-server binary (auto-detected if not set)
#   LLM_MODEL_DIR   Default model directory (default: ~/ai_models)
#   LLM_PORT        Server port (default: 8081)
#   LLM_CTX_SIZE    Context size (default: 65536)

set -euo pipefail

# ═══════════════════════════════════════════════════════════════
# 0. Resolve paths (needed before anything else)
# ═══════════════════════════════════════════════════════════════

_resolve_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
        local dir
        dir="$(cd "$(dirname "$src")" 2>/dev/null && pwd -P)" || break
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd "$(dirname "$src")" 2>/dev/null && pwd -P
}

_discover_app_home() {
    [[ -n "${LLM_APP_HOME:-}" ]] && { echo "$LLM_APP_HOME"; return 0; }
    [[ "$(basename "$SCRIPT_DIR")" == "bin" ]] || return 1
    local parent
    parent="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P)" || return 1
    [[ -d "$parent/models" || -d "$parent/config" || -d "$parent/cache" ]] || return 1
    echo "$parent"
}

SCRIPT_DIR="$(_resolve_script_dir || true)"
PARSE_GGUF="$SCRIPT_DIR/parse_gguf.py"
if [[ ! -f "$PARSE_GGUF" ]]; then
    _alt="$(command -v parse_gguf.py 2>/dev/null || true)"
    [[ -n "$_alt" ]] && PARSE_GGUF="$_alt"
fi

LLM_APP_HOME="$(_discover_app_home 2>/dev/null || true)"
[[ -n "${LLM_APP_HOME:-}" ]] && export LLM_APP_HOME

# ═══════════════════════════════════════════════════════════════
# 1. Source core modules (constants → helpers → config)
# ═══════════════════════════════════════════════════════════════

_LIB_DIR="${SCRIPT_DIR}/lib"
source "${_LIB_DIR}/00-constants.sh"
source "${_LIB_DIR}/01-helpers.sh"
source "${_LIB_DIR}/02-config.sh"

# ═══════════════════════════════════════════════════════════════
# 2. Config discovery (before defaults — mirrors original order)
# ═══════════════════════════════════════════════════════════════

if [[ -z "${LLM_CONFIG:-}" && -n "$LLM_APP_HOME" && ( -f "$LLM_APP_HOME/config/config" || -f "$LLM_APP_HOME/config/config.sh" ) ]]; then
    LLM_CONFIG="$LLM_APP_HOME/config/config"
    [[ -f "$LLM_CONFIG" ]] || LLM_CONFIG="$LLM_APP_HOME/config/config.sh"
else
    LLM_CONFIG="${LLM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/llm-server/config}"
fi

_migrate_legacy_config_sh "$LLM_CONFIG"
[[ -f "$LLM_CONFIG" ]] && source "$LLM_CONFIG"

# ═══════════════════════════════════════════════════════════════
# 3. Set defaults (after config — can see config file values)
# ═══════════════════════════════════════════════════════════════

CONFIG_DIR="${LLM_CONFIG_DIR:-${LLM_APP_HOME:+$LLM_APP_HOME/config}}"
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/llm-server}"
CONFIG_FILE="$LLM_CONFIG"

PORT="${LLM_PORT:-8081}"
HOST="0.0.0.0"
CTX_SIZE="${LLM_CTX_SIZE:-65536}"
CTX_EXPLICIT=0
[[ -n "${LLM_CTX_SIZE:-}" ]] && CTX_EXPLICIT=1

# Tuning constants
MAX_RESTARTS="${LLM_MAX_RESTARTS:-5}"
KEEP_ALIVE="${LLM_KEEP_ALIVE:-0}"
TUNE_LONG_TIMEOUT=0
SYSTEM_HEADROOM_MB=5120
COMPUTE_PER_GPU_MB=512
MIN_CRAM_MB=512
VRAM_OVERHEAD_PERCENT=130
SINGLE_GPU_HEADROOM_MB=4096

# Placement constants
COMPUTE_FLOOR_MB=1024

# Path constants
MODEL_DIR="${LLM_MODEL_DIR:-${LLM_APP_HOME:+$LLM_APP_HOME/models}}"
MODEL_DIR="${MODEL_DIR:-$HOME/ai_models}"
mkdir -p "$MODEL_DIR"
CACHE_DIR="${LLM_CACHE_DIR:-${LLM_APP_HOME:+$LLM_APP_HOME/cache}}"
CACHE_DIR="${CACHE_DIR:-$HOME/.cache/llm-server}"
PROBE_CACHE_DIR="${LLM_PROBE_CACHE_DIR:-$CACHE_DIR/probes}"
LOG_DIR="${LLM_LOG_DIR:-${LLM_APP_HOME:+$LLM_APP_HOME/logs}}"
LOG_DIR="${LOG_DIR:-/tmp}"
mkdir -p "$CACHE_DIR" "$LOG_DIR"
SERVER_LOG="$LOG_DIR/llm-server.log"
BENCHMARK_LOG="$LOG_DIR/llm-bench.log"
# Guard against stale directory at log path
[[ -d "$SERVER_LOG" ]] && rm -rf "$SERVER_LOG" 2>/dev/null || SERVER_LOG="/tmp/llm-server-$$.log"
[[ -d "$BENCHMARK_LOG" ]] && rm -rf "$BENCHMARK_LOG" 2>/dev/null || BENCHMARK_LOG="/tmp/llm-bench-$$.log"

# Flag variables
RETUNE=0
USER_TUNE_ROUNDS=""
DOWNLOAD=0
DRY_RUN=0
VERBOSE=0
BENCHMARK=0
CPU_ONLY=0
MODEL_ARG=""
USER_SERVER_BIN=""
USER_LIB_PATH=""
EXPLICIT_TUNE_CACHE=""
EXTRA_LLAMA_FLAGS=()
TUNE_USER_LOCKED_KEYS=()
KV_QUALITY="low"
KV_QUALITY_EXPLICIT=0
KV_PLACEMENT="${LLM_KV_PLACEMENT:-auto}"
KV_PLACEMENT_EXPLICIT=0
[[ -n "${LLM_KV_PLACEMENT:-}" ]] && KV_PLACEMENT_EXPLICIT=1
PARALLEL_SLOTS=""
SPEC_TYPE=""
SPEC_DRAFT_N_MAX=""
GPUS_FILTER=""
RAM_BUDGET_MB=0
MMPROJ_PATH=""
DO_UPDATE=0
SHOW_CONFIGS=0
DO_AI_TUNE=0
DO_UNLIMITED=0
DO_CONVERGE=0
BACKEND=""
GPU_BACKEND="cuda"
IS_WSL2=0

# Ensure ~/.local/bin is on PATH
export PATH="$HOME/.local/bin:$PATH"

# ═══════════════════════════════════════════════════════════════
# 4. Source remaining modules
# ═══════════════════════════════════════════════════════════════

for _mod in 03-args 04-hardware 05-model 06-flags 07-process 08-benchmark 09-ai-tune 10-moe 11-update 12-show-configs; do
    if [[ -f "${_LIB_DIR}/${_mod}.sh" ]]; then
        source "${_LIB_DIR}/${_mod}.sh"
    else
        echo "Error: lib/${_mod}.sh not found at ${_LIB_DIR}/" >&2
        exit 1
    fi
done
unset _mod _LIB_DIR

# ═══════════════════════════════════════════════════════════════
# 5. Global state initialization
# ═══════════════════════════════════════════════════════════════

RUNNING_PID=""
LAUNCH_ENV_PREFIX=()

# ═══════════════════════════════════════════════════════════════
# 6. Signal handlers & cleanup
# ═══════════════════════════════════════════════════════════════

_pgid_of() {
    local pid="${1:-}"
    [[ -z "$pid" ]] && return 1
    kill -0 "$pid" 2>/dev/null || return 1
    local pgid
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ') || return 1
    [[ -n "$pgid" ]] || return 1
    echo "$pgid"
}

_cleanup_orphan_server() {
    local pid="${RUNNING_PID:-}"
    [[ -z "$pid" ]] && return 0
    kill -0 "$pid" 2>/dev/null || return 0
    local pgid
    pgid=$(_pgid_of "$pid" 2>/dev/null || true)
    if [[ -n "$pgid" && "$pgid" != "$$" && "$pgid" != "$(ps -o pgid= -p $$ | tr -d ' ')" ]]; then
        kill -TERM -- "-$pgid" 2>/dev/null || true
    else
        kill -TERM "$pid" 2>/dev/null || true
    fi
    local i=0
    while (( i < 5 )) && kill -0 "$pid" 2>/dev/null; do sleep 1; (( ++i )); done
    if kill -0 "$pid" 2>/dev/null; then
        if [[ -n "$pgid" && "$pgid" != "$$" && "$pgid" != "$(ps -o pgid= -p $$ | tr -d ' ')" ]]; then
            kill -KILL -- "-$pgid" 2>/dev/null || true
        else
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi
}

cleanup() {
    if [[ -n "${LIB_HUB_DIR:-}" && -d "$LIB_HUB_DIR" ]]; then
        rm -rf "$LIB_HUB_DIR"
    fi
}

_on_exit() {
    _cleanup_orphan_server
    cleanup
}
trap _on_exit EXIT

# ═══════════════════════════════════════════════════════════════
# 7. Lib hub (needed before any binary operations)
# ═══════════════════════════════════════════════════════════════

setup_lib_hub() {
    local bin_path="$1"
    local bin_dir
    bin_dir="$(dirname "$bin_path")"
    local build_root
    build_root="$(dirname "$bin_dir")"

    if [[ ! -d "$build_root" ]]; then return; fi

    # Skip for system-installed binaries
    case "$bin_dir" in
        /usr/bin|/usr/local/bin|/bin|/sbin|/usr/sbin|/opt/*/bin)
            [[ -n "${LIB_HUB_DIR:-}" && -d "$LIB_HUB_DIR" ]] && rm -rf "$LIB_HUB_DIR"
            LIB_HUB_DIR=""
            return
            ;;
    esac

    # Require a recognizable llama.cpp / ik_llama.cpp build tree
    local _has_libllama_versioned=0
    compgen -G "$bin_dir/libllama.so.*" >/dev/null 2>&1 && _has_libllama_versioned=1
    if [[ ! -d "$build_root/ggml" && ! -d "$build_root/src" && \
          ! -e "$bin_dir/libllama.so" && $_has_libllama_versioned -eq 0 ]]; then
        [[ -n "${LIB_HUB_DIR:-}" && -d "$LIB_HUB_DIR" ]] && rm -rf "$LIB_HUB_DIR"
        LIB_HUB_DIR=""
        return
    fi

    [[ -n "${LIB_HUB_DIR:-}" && -d "$LIB_HUB_DIR" ]] && rm -rf "$LIB_HUB_DIR"
    LIB_HUB_DIR=$(mktemp -d /tmp/llm-lib-hub.XXXXXX)

    find "$build_root" -name "*.so*" -type f -exec ln -sf {} "$LIB_HUB_DIR/" \; 2>/dev/null

    for real_lib in "$LIB_HUB_DIR"/*.so.*.*; do
        [[ -f "$real_lib" ]] || continue
        local base
        base="$(basename "$real_lib")"
        local so_major="${base%.*.*}"
        [[ "$so_major" != "$base" && ! -e "$LIB_HUB_DIR/$so_major" ]] && \
            ln -sf "$real_lib" "$LIB_HUB_DIR/$so_major"
        local so_base="${base%%\.so\.*}.so"
        [[ ! -e "$LIB_HUB_DIR/$so_base" ]] && \
            ln -sf "$real_lib" "$LIB_HUB_DIR/$so_base"
    done

    export LD_LIBRARY_PATH="$LIB_HUB_DIR:${LD_LIBRARY_PATH:-}"
    export LD_LIBRARY_PATH="${bin_dir}:$LD_LIBRARY_PATH"
}

find_server_binary() {
    if [[ -n "${USER_SERVER_BIN:-}" && -x "$USER_SERVER_BIN" ]]; then
        echo "$USER_SERVER_BIN"
        return
    fi
    if [[ -n "${LLAMA_SERVER:-}" && -x "$LLAMA_SERVER" ]]; then
        echo "$LLAMA_SERVER"
        return
    fi

    local candidates=()

    if [[ "$BACKEND" == "ik_llama" ]]; then
        candidates+=("$HOME/ik_llama.cpp/build/bin/llama-server")
    elif [[ "$BACKEND" == "llama" ]]; then
        candidates+=("$SCRIPT_DIR/llama-server")
        candidates+=("$HOME/.local/bin/llama-server")
        candidates+=("$HOME/llama.cpp/build/bin/llama-server")
    else
        candidates=(
            "$SCRIPT_DIR/llama-server"
            "$HOME/.local/bin/llama-server"
            "$HOME/ik_llama.cpp/build/bin/llama-server"
            "$HOME/llama.cpp/build/bin/llama-server"
        )
    fi

    candidates+=("$(command -v llama-server 2>/dev/null || true)")

    for bin in "${candidates[@]}"; do
        [[ -n "$bin" && -x "$bin" ]] && echo "$bin" && return
    done
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# 7b. Main launch function (called after dispatch picks *)
# ═══════════════════════════════════════════════════════════════
_main_launch() {
    # Parse arguments
    _parse_args "$@"
    record_user_tune_locks
    _validate_args

    # Find binary
    LLAMA_SERVER="$(find_server_binary)"
    [[ -z "$LLAMA_SERVER" ]] && { echo "Error: llama-server binary not found."; echo "Set LLAMA_SERVER env var, use --server-bin, or install ik_llama.cpp / llama.cpp."; exit 1; }
    setup_lib_hub "$LLAMA_SERVER"

    # Parse --lib-path
    [[ -n "$USER_LIB_PATH" ]] && export LD_LIBRARY_PATH="${USER_LIB_PATH}:${LD_LIBRARY_PATH:-}"

    # Verify binary
    _bin_check=$(timeout 5 "$LLAMA_SERVER" --help 2>&1 || true)
    if [[ "$_bin_check" == *"shared libraries"* ]]; then
        echo "Error: $LLAMA_SERVER has broken shared libraries:"
        echo "$_bin_check" | grep "shared libraries" | head -3
        echo ""; echo "Fix: rebuild (cmake --build build --config Release)"
        if [[ "$LLAMA_SERVER" == *ik_llama* ]]; then ALT_BIN="$HOME/llama.cpp/build/bin/llama-server"
        else ALT_BIN="$HOME/ik_llama.cpp/build/bin/llama-server"; fi
        if [[ -x "$ALT_BIN" ]]; then
            setup_lib_hub "$ALT_BIN"
            _alt_check=$(timeout 5 "$ALT_BIN" --help 2>&1 || true)
            if [[ "$_alt_check" != *"shared libraries"* ]]; then
                echo "Falling back to: $ALT_BIN"; LLAMA_SERVER="$ALT_BIN"
            else echo "Error: Both backends have broken shared libraries."; exit 1; fi
        else exit 1; fi
    fi
    export CUDA_DEVICE_ORDER=PCI_BUS_ID

    # Show configs
    if (( SHOW_CONFIGS )); then
        if [[ -n "$MODEL_ARG" ]]; then show_configs_detail "$MODEL_ARG"; else show_configs_table; fi
        exit 0
    fi

    # Validate model
    if [[ -z "$MODEL_ARG" ]]; then
        echo "Error: No model specified. Usage: llm-server <model.gguf> or <repo/name> --download"
        exit 1
    fi
    if [[ ! -f "$MODEL_ARG" ]]; then
        if [[ -f "$MODEL_DIR/$MODEL_ARG" ]]; then MODEL_ARG="$MODEL_DIR/$MODEL_ARG"
        else echo "Error: Model not found: $MODEL_ARG"; exit 1; fi
    fi

    # Apply --server-bin override
    [[ -n "$USER_SERVER_BIN" ]] && { LLAMA_SERVER="$USER_SERVER_BIN"; setup_lib_hub "$LLAMA_SERVER"; }

    echo "═══ llm-server v$VERSION ═══"; echo "Binary: $LLAMA_SERVER"

    # Determine model path
    MODEL_PATH="$MODEL_ARG"
    MODEL_NAME="$(basename "$MODEL_PATH")"

    # Detect hardware (GPU/RAM/CPU) — needed by model init
    _detect_hardware

    # Detect model (GGUF parsing, metadata, binary/backend detection)
    _detect_model

    # Build flag arrays (depends on hardware + model info)
    _build_flags

    # AI Tune initialization (depends on DO_UNLIMITED from model init)
    if (( DO_UNLIMITED )); then AI_TUNE_ROUNDS="${USER_TUNE_ROUNDS:-20}"; TUNE_LONG_TIMEOUT=1
    else AI_TUNE_ROUNDS="${USER_TUNE_ROUNDS:-12}"; fi

    # Pre-launch: stop llama listeners for AI tune
    if (( DO_AI_TUNE && ! DRY_RUN )); then _stop_llama_listeners_for_ai_tune; fi

    # Apply --lib-path override
    [[ -n "$USER_LIB_PATH" ]] && export LD_LIBRARY_PATH="${USER_LIB_PATH}:${LD_LIBRARY_PATH:-}"

    # Check updates (background-friendly)
    if [[ -z "${LLM_SERVER_UPDATE_CHECKED:-}" ]] && _should_check_updates; then
        _updates=()
        _check_repo_behind "$LLM_SERVER_REPO" "llm-server" && _updates+=("llm-server")
        _ik_dir="$(dirname "$(dirname "$(dirname "$LLAMA_SERVER")")")"
        [[ "$_ik_dir" == *ik_llama* ]] && _check_repo_behind "$_ik_dir" "ik_llama.cpp" && _updates+=("ik_llama.cpp")
        _ll_dir="$HOME/llama.cpp"
        [[ -d "$_ll_dir" ]] && _check_repo_behind "$_ll_dir" "llama.cpp" && _updates+=("llama.cpp")
        if (( ${#_updates[@]} > 0 )); then
            echo -e "\033[1;31m⚠ Updates available: ${_updates[*]}\033[0m"
            if [[ -t 0 ]] || [[ -t 1 ]]; then
                read -r -t 20 -p "  Update now? [y/N/d=dismiss ${UPDATE_DISMISS_DAYS} days] " _answer < /dev/tty 2>/dev/null || _answer=""
            else echo "  (skipped in non-interactive mode)"; _answer="n"; fi
            case "${_answer,,}" in
                y) echo "Running --update..."; exec "$0" --update ;;
                d) mkdir -p "$CACHE_DIR"; date +%s > "$UPDATE_DISMISS_FILE"; echo "  Dismissed for ${UPDATE_DISMISS_DAYS} days." ;;
                *) echo "  Skipped." ;;
            esac
        fi
        export LLM_SERVER_UPDATE_CHECKED=1
    fi

    # Run two-phase benchmark (if --benchmark)
    if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi

    # Maybe AI Tune launch flags
    maybe_ai_tune_launch_flags "${COMMON_FLAGS[@]}"

    # Kill any existing server on this port
    kill_server ""

    # Execute strategy
    case "$STRATEGY" in
        cpu_only) _strategy_cpu_only ;;
        single_gpu) _strategy_single_gpu ;;
        multi_gpu_dense) _strategy_multi_gpu_dense ;;
        dense_cpu_offload) _strategy_dense_cpu_offload ;;
        moe_offload) _run_moe_placement ;;
        *) echo "Error: Unknown strategy: $STRATEGY"; exit 1 ;;
    esac

    # MoE offload falls through to lib/10-moe.sh execution
}


# ── Strategy helpers ──────────────────────────────────────────
_strategy_cpu_only() {
    local LAUNCH_FLAGS=( -m "$MODEL_PATH" --host "$HOST" --port "$PORT" --ctx-size "$CTX_SIZE" --flash-attn on -b 512 -ub 256 -ngl 0 --cache-type-k "$KV_TYPE" --cache-type-v "$KV_TYPE" --jinja --threads "$THREADS_GEN" --threads-batch "$THREADS_BATCH" )
    (( SUPPORTS_REASONING_FLAG && ! USER_REASONING_EXPLICIT )) && LAUNCH_FLAGS+=(--reasoning off)
    (( ! IS_WSL2 )) && LAUNCH_FLAGS+=(--mlock)
    [[ -n "$CONTEXT_SHIFT_FLAG" ]] && LAUNCH_FLAGS+=("$CONTEXT_SHIFT_FLAG")
    [[ -n "$MMPROJ_PATH" ]] && LAUNCH_FLAGS+=(--mmproj "$MMPROJ_PATH")
    (( DRY_RUN && BENCHMARK )) && LAUNCH_FLAGS=("${BASE_FLAGS[@]}")
    if (( DRY_RUN )); then print_cmd "${LAUNCH_FLAGS[@]}"; exit 0; fi
    if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
    maybe_ai_tune_launch_flags "${LAUNCH_FLAGS[@]}"
    run_with_restart "${LAUNCH_FLAGS[@]}"
}

_strategy_single_gpu() {
    local_best=${GPU_ORDER[0]}
    echo "Model fits on GPU${GPU_INDEX[$local_best]} (${GPU_NAME[$local_best]})"
    local LAUNCH_FLAGS=("${COMMON_FLAGS[@]}" --device "${GPU_BACKEND}${GPU_INDEX[$local_best]}")
    (( DRY_RUN && BENCHMARK )) && LAUNCH_FLAGS=("${BASE_FLAGS[@]}")
    if (( DRY_RUN )); then print_cmd "${LAUNCH_FLAGS[@]}"; exit 0; fi
    if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
    maybe_ai_tune_launch_flags "${LAUNCH_FLAGS[@]}"
    run_with_restart "${COMMON_FLAGS[@]}"
}

_strategy_multi_gpu_dense() {
    USE_GPU_COUNT=$GPU_COUNT
    for n in $(seq 2 $(( GPU_COUNT ))); do
        subset_vram=0
        for j in $(seq 0 $(( n - 1 ))); do
            gi=${GPU_ORDER[$j]}; gi_usable=$(( GPU_VRAM_TOTAL[$gi] - 1024 )); (( gi_usable < 0 )) && gi_usable=0
            (( subset_vram += gi_usable )) || true
        done
        (( VRAM_NEEDED_MB <= subset_vram )) && { USE_GPU_COUNT=$n; break; }
    done
    declare -A SELECTED_GPUS
    for j in $(seq 0 $(( USE_GPU_COUNT - 1 ))); do SELECTED_GPUS[${GPU_ORDER[$j]}]=1; done
    if (( USE_GPU_COUNT < GPU_COUNT )); then
        echo "Dense model split across $USE_GPU_COUNT of $GPU_COUNT GPUs (skipping slower GPUs)"
        for j in $(seq 0 $(( USE_GPU_COUNT - 1 ))); do
            gi=${GPU_ORDER[$j]}; echo "  Using GPU${GPU_INDEX[$gi]}: ${GPU_NAME[$gi]} (bw=${GPU_BANDWIDTH[$gi]})"
        done
    else echo "Dense model split across $GPU_COUNT GPUs"; fi
    total_weighted=0
    for i in $(seq 0 $(( GPU_COUNT - 1 ))); do
        [[ -n "${SELECTED_GPUS[$i]:-}" ]] && (( total_weighted += GPU_VRAM_FREE[$i] * GPU_BANDWIDTH[$i] )) || true
    done
    TS=""
    for i in $(seq 0 $(( GPU_COUNT - 1 ))); do
        if [[ -n "${SELECTED_GPUS[$i]:-}" ]]; then
            w=$(awk "BEGIN {printf \"%.2f\", ${GPU_VRAM_FREE[$i]} * ${GPU_BANDWIDTH[$i]} / $total_weighted}")
        else w="0.00"; fi
        TS="${TS:+$TS,}$w"
    done
    echo "Tensor split: $TS"
    GRAPH_EXTRA=(--split-mode graph --tensor-split "$TS")
    if (( IS_IK_LLAMA )); then
        LAYER_EXTRA=(--split-mode layer --tensor-split "$TS")
        if (( DRY_RUN )); then if (( BENCHMARK )); then print_cmd "${BASE_FLAGS[@]}"; else print_cmd "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"; fi; exit 0; fi
        echo "Trying graph split (fastest)..."
        if try_start "${GRAPH_EXTRA[@]}"; then
            echo "  Graph split works — restarting with crash recovery..."
            kill_server "$RUNNING_PID"
            if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
            maybe_ai_tune_launch_flags "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"
            run_with_restart "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"
        else
            echo "  Graph split failed — retrying with NCCL_P2P_DISABLE=1..."
            kill_server ""; export NCCL_P2P_DISABLE=1
            if try_start "${GRAPH_EXTRA[@]}"; then
                echo "  Graph split works with P2P disabled — restarting..."
                kill_server "$RUNNING_PID"
                if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
                maybe_ai_tune_launch_flags "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"
                run_with_restart "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"
            else
                echo "  Graph split unavailable — falling back to layer split"
                kill_server ""; unset NCCL_P2P_DISABLE
                if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
                maybe_ai_tune_launch_flags "${COMMON_FLAGS[@]}" "${LAYER_EXTRA[@]}"
                run_with_restart "${COMMON_FLAGS[@]}" "${LAYER_EXTRA[@]}"
            fi
        fi
    else
        if timeout 5 "$LLAMA_SERVER" --help 2>&1 | grep -q "graph" 2>/dev/null; then
            if (( DRY_RUN )); then if (( BENCHMARK )); then print_cmd "${BASE_FLAGS[@]}"; else print_cmd "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"; fi; exit 0; fi
            if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
            maybe_ai_tune_launch_flags "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"
            run_with_restart "${COMMON_FLAGS[@]}" "${GRAPH_EXTRA[@]}"
        else
            LAUNCH_FLAGS=("${COMMON_FLAGS[@]}" --split-mode row --tensor-split "$TS")
            if (( DRY_RUN )); then if (( BENCHMARK )); then print_cmd "${BASE_FLAGS[@]}"; else print_cmd "${LAUNCH_FLAGS[@]}"; fi; exit 0; fi
            if (( BENCHMARK )); then run_two_phase_benchmark; BENCHMARK=0; fi
            maybe_ai_tune_launch_flags "${LAUNCH_FLAGS[@]}"
            run_with_restart "${LAUNCH_FLAGS[@]}"
        fi
    fi
}

